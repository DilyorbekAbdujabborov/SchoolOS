# docker-compose-level configuration — copy to .env in this same directory
# (never commit the real .env; see backend/.env.example for the app's own
# secrets, which live in backend/.env instead).

# The public domain this deployment is served on. Caddy automatically gets a
# free HTTPS certificate for it (Let's Encrypt) as long as the server's
# ports 80/443 are reachable from the internet and DNS already points here.
# Leave as localhost only for testing docker-compose on your own machine.
DOMAIN=localhost

# PostgreSQL credentials — pick a real password, not this placeholder.
DJANGO_DB_NAME=schoolos
DJANGO_DB_USER=schoolos
DJANGO_DB_PASSWORD=change-me
